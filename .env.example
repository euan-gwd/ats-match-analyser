# Example .env file for secure deployment
# Copy this to .env and fill in your values
# NEVER commit .env to version control!

# Security - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=your-encryption-key-here

# GDPR/Privacy Contact
DPO_EMAIL=privacy@yourdomain.com
SECURITY_EMAIL=security@yourdomain.com

# Application Settings
DEBUG_MODE=false
LOG_LEVEL=INFO

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
AUTO_DELETE_AFTER_MINUTES=30

# Rate Limiting
MAX_REQUESTS_PER_HOUR=10

# File Size Limits (in bytes)
MAX_RESUME_SIZE=10485760  # 10MB
MAX_JD_SIZE=5242880       # 5MB

# Deployment
ENVIRONMENT=production
ALLOWED_ORIGINS=https://yourdomain.com

# .gitignore additions for security

# Environment variables and secrets
.env
.env.local
.env.*.local
secrets.toml
config.toml

# User data (should never be committed)
uploads/
user_data/
sessions/
*.pdf
*.docx

# Logs that might contain PII
logs/
*.log
audit.log

# Security
.security/
certificates/
*.key
*.pem
*.crt

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing
.coverage
.pytest_cache/
htmlcov/
.tox/

# Deployment
*.sock
*.pid
deployment_keys/
